#!/bin/sh
# Sync the GNOME color-scheme with noctalia's theme mode. Called from a
# noctalia hook with "true"/"dark" for dark mode.
#
# dconf writes the key directly and needs no schema lookup, so this works
# from noctalia's bare hook environment without guessing store paths.
set -eu

mode="${1:-}"
case "$mode" in
  true | dark) scheme="prefer-dark" ;;
  *) scheme="prefer-light" ;;
esac

dconf write /org/gnome/desktop/interface/color-scheme "'$scheme'"
